{
  "extends": [
    "next/core-web-vitals",
    "plugin:tailwindcss/recommended",
    "prettier"
  ],
  "plugins": ["tailwindcss"],
  "rules": {
    "tailwindcss/no-custom-classname": "off", // ✅ Allow custom class names
    "tailwindcss/classnames-order": "off",
    "tailwindcss/enforces-shorthand": "off",
    "tailwindcss/no-contradicting-classname": "error",
    "no-console":  "error" 
  },
  "settings": {
    "tailwindcss": {
      "callees": ["twMerge", "createTheme", "classnames", "clsx"], // ✅ Added common utility libraries
      "classRegex": "^(class(Name)?|theme)$" // ✅ Fixed regex for matching class attributes
    }
  }
}